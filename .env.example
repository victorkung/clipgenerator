# Optional config for clipgenerator. Copy to .env (never commit .env).
#
# Local MLX Whisper is the default STT — no API key required.
#
# Optional: put model cache on an external drive (e.g. large models / future LLMs)
# MODEL_DIR=/Volumes/VK Power/Open Source Models
# HF_HOME=/Volumes/VK Power/Open Source Models
#
# Default Whisper size: tiny | base | small | medium | large-v3 | large-v3-turbo
# WHISPER_MODEL=medium
